---
---

<section class="hero-section">
  <div class="hero-inner">
    <div class="hero-copy">
      <span class="service-tag hero-reveal hero-reveal-1">Engineering Leader &middot; Pharmacy-Data Monetization</span>
      <h1 class="hero-reveal hero-reveal-2">Nick Ruffin</h1>
      <p class="hero-subtitle hero-reveal hero-reveal-3">
        I lead engineering for RedSail's pharmacy-data monetization platform &mdash; serving RWE aggregators and pharma manufacturers with Datavant-tokenized feeds, customer-controlled Azure delivery, and cross-source combined feeds.
      </p>
      <div class="cta-wrapper hero-reveal hero-reveal-4">
        <a href="/experience" class="primary-cta">See Experience</a>
        <a href="/nicholas-ruffin-resume.pdf" target="_blank" class="secondary-cta">Download Resume</a>
      </div>
    </div>

    <div class="hero-portrait hero-reveal hero-reveal-3">
      <div class="portrait-card">
        <div class="portrait-image" style="background-image: url('/images/nick-headshot.jpg');"></div>
        <div class="portrait-tint"></div>
        <div class="portrait-label">
          <span class="portrait-label-name">Nick Ruffin</span>
          <span class="portrait-label-role">Manager, Data Product Engineering &middot; RedSail Technologies</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - var(--nav-height));
    padding: 120px 32px 80px;
    background: var(--background-color);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-inner {
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: heroReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-reveal-1 { animation-delay: 0.10s; }
  .hero-reveal-2 { animation-delay: 0.25s; }
  .hero-reveal-3 { animation-delay: 0.40s; }
  .hero-reveal-4 { animation-delay: 0.55s; }

  @keyframes heroReveal {
    to { opacity: 1; transform: translateY(0); }
  }

  .service-tag {
    display: inline-block;
    padding: 5px 12px;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  h1 {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(3rem, 6.5vw, 5rem);
    font-weight: 700;
    line-height: 1.02;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--text-color);
  }

  .hero-subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    max-width: 540px;
  }

  .cta-wrapper {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .primary-cta,
  .secondary-cta {
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .primary-cta {
    background: #191918;
    color: #ffffff;
    border: 1px solid #191918;
  }
  .primary-cta:hover {
    background: #37352f;
    border-color: #37352f;
    transform: translateY(-1px);
  }

  .secondary-cta {
    background: transparent;
    color: var(--text-color);
    border: 1px solid rgba(0, 0, 0, 0.14);
  }
  .secondary-cta:hover {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.25);
  }

  /* Portrait card — Notion tinted-card treatment */
  .hero-portrait {
    display: flex;
    justify-content: center;
  }

  .portrait-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px -20px rgba(30, 58, 138, 0.35),
                0 4px 12px -4px rgba(0, 0, 0, 0.08);
  }

  .portrait-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 25%;
    filter: grayscale(0.15) contrast(1.02);
  }

  .portrait-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(30, 58, 138, 0.55) 0%,
      rgba(30, 58, 138, 0.45) 50%,
      rgba(15, 23, 42, 0.85) 100%
    );
    mix-blend-mode: multiply;
  }

  .portrait-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(59, 130, 246, 0.25) 0%,
      transparent 40%,
      rgba(15, 23, 42, 0.4) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .portrait-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 32px 28px 28px;
    color: #ffffff;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .portrait-label-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .portrait-label-role {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    opacity: 0.9;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-portrait {
      order: -1;
    }
    .portrait-card {
      max-width: 380px;
      aspect-ratio: 3 / 4;
    }
  }

  @media (max-width: 640px) {
    .hero-section { padding: 100px 20px 60px; }
    .cta-wrapper {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .primary-cta, .secondary-cta {
      text-align: center;
    }
    .portrait-card { max-width: 320px; }
    .portrait-label { padding: 24px 20px 20px; }
    .portrait-label-name { font-size: 1.2rem; }
  }
</style>
